{
  "info": {
    "_postman_id": "9e4c2a71-3b8d-4f6e-a1d2-7c5b8e0f3a22",
    "name": "MS Account",
    "description": "Pruebas de /api/v1/accounts (cuentas, titulares y firmantes). Requiere ms-customer en 8080 y ms-account en 8081. Ejecutar las carpetas en orden 0 a 5. Cada ejecucion genera DNI y RUC nuevos en la carpeta 0. ms-credit (8082) no es necesario: la cuenta corriente PYME acepta 400 o 503. Desde Part III todas las llamadas requieren JWT: obtener el accessToken con POST ms-customer (8080) /api/v1/auth/login y pegarlo en la variable token de la coleccion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "token", "value": "" },
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "customerBaseUrl", "value": "http://localhost:8080" },
    { "key": "dni", "value": "" },
    { "key": "rucPyme", "value": "" },
    { "key": "rucStandard", "value": "" },
    { "key": "personalId", "value": "" },
    { "key": "pymeId", "value": "" },
    { "key": "standardId", "value": "" },
    { "key": "savingsId", "value": "" },
    { "key": "businessAccountId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Preparacion (ms-customer)",
      "item": [
        {
          "name": "Crear cliente personal (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"dni\", String(Math.floor(10000000 + Math.random() * 89999999)));",
                  "pm.collectionVariables.set(\"rucPyme\", \"20\" + String(Math.floor(100000000 + Math.random() * 899999999)));",
                  "pm.collectionVariables.set(\"rucStandard\", \"20\" + String(Math.floor(100000000 + Math.random() * 899999999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set(\"personalId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerType\": \"PERSONAL\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"{{dni}}\",\n  \"profile\": \"STANDARD\",\n  \"email\": \"cuentas.personal@example.com\",\n  \"phone\": \"999111222\",\n  \"personalDetails\": {\n    \"firstName\": \"Luis\",\n    \"lastName\": \"Mendoza\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{customerBaseUrl}}/api/v1/customers",
              "host": ["{{customerBaseUrl}}"],
              "path": ["api", "v1", "customers"]
            }
          }
        },
