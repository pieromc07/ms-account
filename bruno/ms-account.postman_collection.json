              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            }
          }
        },
        {
          "name": "Listar cuentas por tipo CURRENT (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Todas las cuentas son CURRENT\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.response.json().forEach(function (a) {",
                  "        pm.expect(a.accountType).to.eql(\"CURRENT\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts?accountType=CURRENT",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"],
              "query": [{ "key": "accountType", "value": "CURRENT" }]
            }
          }
        },
